{
  "name": "pg-rebac",
  "version": "0.3.0",
  "description": "pg_rebac's SQL, bundled: install the permission-aware fence into Postgres from your own migrations",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pg_rebac.sql": "./sql/pg_rebac.sql",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louvain-ai/pg_rebac.git",
    "directory": "packages/npm"
  },
  "homepage": "https://pgrebac.com",
  "bugs": {
    "url": "https://github.com/louvain-ai/pg_rebac/issues"
  },
  "keywords": [
    "postgres",
    "spicedb",
    "authorization",
    "rebac",
    "permissions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:sql": "bash ../../scripts/release-sql.sh \"$npm_package_version\" sql/pg_rebac.sql",
    "build": "npm run build:sql && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
